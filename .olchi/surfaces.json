{
  "schema_version": "olchi-project-surfaces.v1",
  "project_id": "olchipanel",
  "runtimes": [
    {
      "id": "championship-preview",
      "status": "active",
      "mode": "on_demand",
      "owner": "project-agent",
      "source_path": "tools/preview-championship-demo.cjs",
      "exposure": "local",
      "bind_host": "127.0.0.1",
      "port_policy": {
        "mode": "dynamic"
      },
      "start_command": [
        "node",
        "tools/preview-championship-demo.cjs"
      ],
      "stop_method": "Ctrl+C in the owning preview terminal",
      "health_url": null,
      "discovery_file": "output/championship-demo/preview.json",
      "discovery_method": "file",
      "startup": "manual",
      "expiry": {
        "mode": "timestamp",
        "at": "2026-09-21T00:00:00+09:00"
      },
      "approval_ref": null
    },
    {
      "id": "viewer",
      "status": "active",
      "mode": "on_demand",
      "owner": "project-agent",
      "source_path": "src/viewer.js",
      "exposure": "local",
      "bind_host": "127.0.0.1",
      "port_policy": {
        "mode": "fixed",
        "port": 6711
      },
      "start_command": [
        "node",
        "bin/olchipanel.js",
        "open"
      ],
      "stop_method": "If owned by the desktop app: tray icon > 종료; otherwise Ctrl+C in the owning terminal or `node bin/olchipanel.js stop`",
      "health_url": "http://127.0.0.1:6711/api/state",
      "discovery_file": "${USERPROFILE}/.olchipanel/viewer.json",
      "discovery_method": "file",
      "startup": "manual",
      "expiry": {
        "mode": "condition",
        "condition": "열린 MCP 세션·viewer가 없으면 종료 가능"
      },
      "approval_ref": null
    }
  ],
  "surfaces": [
    {
      "id": "championship-demo",
      "title": "OlchiPanel Championship sample demo",
      "kind": "web-app",
      "purpose": "Studio 기반 7단계 데모와 날짜별 방문자·매출 분석, 샘플 노트·플랜 반영의 로컬 검수",
      "owner": "project-agent",
      "status": "active",
      "source_path": "tools/championship/index.html",
